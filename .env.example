# Copy to .env and load it with: node --env-file=.env src/server.js

# Shared secret configured on the GitHub webhook (min. 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=

# Optional. Fine-grained token with "Contents" and "Pull requests" write access
# on the target repository. Without it the agent runs in dry-run mode.
GITHUB_TOKEN=

# Optional. Ed25519 private key (PKCS#8 PEM, newlines as \n) used to sign the
# audit ledger. Generate with: openssl genpkey -algorithm ed25519
ATTESTATION_PRIVATE_KEY=

PORT=8787
HOST=127.0.0.1
MAX_REPAIR_ATTEMPTS=3

# realistic = mocked model with built-in failure modes, ideal = always correct
LLM_PROFILE=realistic

# 1 = local demo: random webhook secret, dry-run GitHub, scenario buttons in the UI
GUARDIAN_DEMO=0
