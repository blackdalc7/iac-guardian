{
  "name": "iac-guardian",
  "version": "1.0.0",
  "private": true,
  "description": "Self-healing CI/CD security agent: an LLM proposes IaC fixes, OPA (WebAssembly) decides whether they ship.",
  "license": "MIT",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "demo": "node scripts/demo.js",
    "dev:web": "vite --config vite.config.mjs",
    "build": "vite build --config vite.config.mjs",
    "policy:build": "node scripts/build-policy.js",
    "policy:test": "opa test policy/rego -v",
    "simulate": "node scripts/simulate.js",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:all": "jest && npm run build && playwright test"
  },
  "dependencies": {
    "@cdktf/hcl2json": "^0.21.0",
    "@open-policy-agent/opa-wasm": "^1.10.0",
    "diff": "^9.0.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "jest": "^30.5.2",
    "postcss": "^8.5.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.3.2",
    "tailwindcss": "^3.4.19",
    "vite": "^6.4.6"
  }
}
